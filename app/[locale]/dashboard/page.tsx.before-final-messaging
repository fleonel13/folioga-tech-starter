"use client";

import Link from "next/link";
import { use, useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "@/lib/supabase";

type UserProfile = {
  email: string;
  role: "client" | "technicien";
};

type Repair = {
  id: string;
  client_id: string;
  title: string;
  device_type: string;
  description: string;
  country: string;
  city: string | null;
  budget: number | null;
  status: string;
  created_at: string;
};

type RepairInterest = {
  repair_request_id: string;
  technician_id: string;
  status: string;
};

type UnreadMessage = {
  id: string;
  repair_request_id: string;
  sender_id: string;
  message: string;
  created_at: string;
  is_read: boolean;
};

type MessageRepair = {
  id: string;
  title: string;
  device_type: string | null;
};

export default function DashboardPage({
  params,
}: {
  params: Promise<{ locale: string }>;
}) {
  const { locale } = use(params);
  const router = useRouter();

  const [profile, setProfile] = useState<UserProfile | null>(null);
  const [userId, setUserId] = useState<string | null>(null);

  const [loading, setLoading] = useState(true);

  const [clientRepairs, setClientRepairs] = useState<Repair[]>([]);
  const [technicianRepairs, setTechnicianRepairs] = useState<Repair[]>([]);

  const [repairsLoading, setRepairsLoading] = useState(false);
  const [repairsError, setRepairsError] = useState<string | null>(null);

  const [unreadMessages, setUnreadMessages] = useState<UnreadMessage[]>([]);
  const [messageRepairs, setMessageRepairs] = useState<
    Record<string, MessageRepair>
  >({});
  const [messagesLoading, setMessagesLoading] = useState(false);
  const [messagesError, setMessagesError] = useState<string | null>(null);

  /*
   * ============================================================
   * CHARGEMENT PRINCIPAL
   * ============================================================
   */

  useEffect(() => {
    let mounted = true;

    async function loadUser() {
      setLoading(true);
      setRepairsError(null);
      setMessagesError(null);

      const {
        data: { user },
        error: userError,
      } = await supabase.auth.getUser();

      if (userError || !user) {
        router.replace(`/${locale}/login`);
        return;
      }

      if (!mounted) return;

      setUserId(user.id);

      /*
       * Récupération du rôle depuis profiles.
       */
      const { data: profileData, error: profileError } =
        await supabase
          .from("profiles")
          .select("role")
          .eq("id", user.id)
          .maybeSingle();

      if (profileError) {
        console.error("Erreur profil :", profileError);
      }

      const metadataRole = user.user_metadata?.role;

      const role: "client" | "technicien" =
        profileData?.role === "technicien" ||
        profileData?.role === "technician" ||
        metadataRole === "technicien" ||
        metadataRole === "technician"
          ? "technicien"
          : "client";

      if (!mounted) return;

      setProfile({
        email: user.email || "",
        role,
      });

      /*
       * Chargement des réparations + messages.
       */
      if (role === "technicien") {
        await loadTechnicianRepairs(user.id);
      } else {
        await loadClientRepairs(user.id);
      }

      await loadUnreadMessages(user.id);

      if (mounted) {
        setLoading(false);
      }
    }

    loadUser();

    return () => {
      mounted = false;
    };
  }, [locale, router]);

  /*
   * ============================================================
   * CLIENT : RÉPARATIONS
   * ============================================================
   */

  async function loadClientRepairs(clientId: string) {
    setRepairsLoading(true);
    setRepairsError(null);

    const { data, error } = await supabase
      .from("repair_requests")
      .select(
        "id, client_id, title, device_type, description, country, city, budget, status, created_at"
      )
      .eq("client_id", clientId)
      .order("created_at", { ascending: false });

    if (error) {
      console.error(
        "Erreur chargement réparations client :",
        error
      );

      setClientRepairs([]);

      setRepairsError(
        `Impossible de charger vos réparations : ${
          error.code || ""
        } ${error.message || ""}`
      );

      setRepairsLoading(false);
      return;
    }

    setClientRepairs((data || []) as Repair[]);
    setRepairsLoading(false);
  }

  /*
   * ============================================================
   * TECHNICIEN : MISSIONS ACCEPTÉES
   * ============================================================
   */

  async function loadTechnicianRepairs(technicianId: string) {
    setRepairsLoading(true);
    setRepairsError(null);

    const { data: interests, error: interestsError } =
      await supabase
        .from("repair_interests")
        .select(
          "repair_request_id, technician_id, status"
        )
        .eq("technician_id", technicianId)
        .eq("status", "accepted");

    if (interestsError) {
      console.error(
        "Erreur chargement intérêts technicien :",
        interestsError
      );

      setTechnicianRepairs([]);

      setRepairsError(
        `Impossible de charger vos missions : ${
          interestsError.code || ""
        } ${interestsError.message || ""}`
      );

      setRepairsLoading(false);
      return;
    }

    if (!interests || interests.length === 0) {
      setTechnicianRepairs([]);
      setRepairsLoading(false);
      return;
    }

    const requestIds = (interests as RepairInterest[])
      .map(
        (interest) => interest.repair_request_id
      )
      .filter(Boolean);

    if (requestIds.length === 0) {
      setTechnicianRepairs([]);
      setRepairsLoading(false);
      return;
    }

    const { data: requests, error: requestsError } =
      await supabase
        .from("repair_requests")
        .select(
          "id, client_id, title, device_type, description, country, city, budget, status, created_at"
        )
        .in("id", requestIds)
        .order("created_at", { ascending: false });

    if (requestsError) {
      console.error(
        "Erreur chargement missions technicien :",
        requestsError
      );

      setTechnicianRepairs([]);

      setRepairsError(
        `Impossible de charger vos missions : ${
          requestsError.code || ""
        } ${requestsError.message || ""}`
      );

      setRepairsLoading(false);
      return;
    }

    setTechnicianRepairs(
      (requests || []) as Repair[]
    );

    setRepairsLoading(false);
  }

  /*
   * ============================================================
   * MESSAGERIE : MESSAGES NON LUS
   * ============================================================
   *
   * IMPORTANT :
   *
   * La table repair_messages contient :
   *
   * id
   * repair_request_id
   * sender_id
   * message
   * created_at
   * is_read
   *
   * Elle ne contient PAS receiver_id.
   *
   * On détermine donc les messages reçus ainsi :
   *
   * sender_id != utilisateur connecté
   * ET
   * is_read = false
   *
   * ============================================================
   */

  async function loadUnreadMessages(currentUserId: string) {
    setMessagesLoading(true);
    setMessagesError(null);

    /*
     * Récupération des messages non lus.
     */
    const { data: messages, error: messagesError } =
      await supabase
        .from("repair_messages")
        .select(
          "id, repair_request_id, sender_id, message, created_at, is_read"
        )
        .eq("is_read", false)
        .neq("sender_id", currentUserId)
        .order("created_at", {
          ascending: false,
        });

    if (messagesError) {
      console.error(
        "Erreur chargement messages non lus :",
        messagesError
      );

      setUnreadMessages([]);

      setMessagesError(
        `Impossible de charger la messagerie : ${
          messagesError.code || ""
        } ${messagesError.message || ""}`
      );

      setMessagesLoading(false);
      return;
    }

    const unread = (messages || []) as UnreadMessage[];

    setUnreadMessages(unread);

    /*
     * Aucun message non lu.
     */
    if (unread.length === 0) {
      setMessageRepairs({});
      setMessagesLoading(false);
      return;
    }

    /*
     * On récupère les IDs des réparations concernées.
     */
    const repairIds = Array.from(
      new Set(
        unread
          .map(
            (message) =>
              message.repair_request_id
          )
          .filter(Boolean)
      )
    );

    if (repairIds.length === 0) {
      setMessageRepairs({});
      setMessagesLoading(false);
      return;
    }

    /*
     * Récupération des informations des réparations.
     */
    const { data: repairsData, error: repairsError } =
      await supabase
        .from("repair_requests")
        .select("id, title, device_type")
        .in("id", repairIds);

    if (repairsError) {
      console.error(
        "Erreur chargement réparations des messages :",
        repairsError
      );

      /*
       * On conserve quand même les messages.
       */
      setMessageRepairs({});
      setMessagesLoading(false);
      return;
    }

    const repairMap: Record<
      string,
      MessageRepair
    > = {};

    (repairsData || []).forEach((repair) => {
      repairMap[repair.id] = {
        id: repair.id,
        title: repair.title,
        device_type: repair.device_type,
      };
    });

    setMessageRepairs(repairMap);
    setMessagesLoading(false);
  }

  /*
   * ============================================================
   * LOGOUT
   * ============================================================
   */

  async function handleLogout() {
    await supabase.auth.signOut();

    router.push(`/${locale}`);
    router.refresh();
  }

  /*
   * ============================================================
   * STATUT
   * ============================================================
   */

  function getStatusLabel(status: string) {
    switch (status) {
      case "open":
        return "🟢 Ouverte";

      case "assigned":
        return "🟠 Technicien assigné";

      case "in_progress":
        return "🔵 Réparation en cours";

      case "completed":
        return "✅ Terminée";

      case "cancelled":
        return "🔴 Annulée";

      default:
        return status;
    }
  }

  function getStatusClass(status: string) {
    switch (status) {
      case "open":
        return "bg-green-50 text-green-700";

      case "assigned":
        return "bg-orange-50 text-orange-700";

      case "in_progress":
        return "bg-blue-50 text-blue-700";

      case "completed":
        return "bg-emerald-50 text-emerald-700";

      case "cancelled":
        return "bg-red-50 text-red-700";

      default:
        return "bg-slate-100 text-slate-700";
    }
  }

  /*
   * ============================================================
   * LOADING
   * ============================================================
   */

  if (loading) {
    return (
      <main className="section">
        <div className="container">
          <div className="card p-10 text-center">
            <p className="font-semibold text-slate-500">
              Chargement de votre espace...
            </p>
          </div>
        </div>
      </main>
    );
  }

  if (!profile) {
    return null;
  }

  const isTechnician =
    profile.role === "technicien";

  const repairs = isTechnician
    ? technicianRepairs
    : clientRepairs;

  const unreadCount = unreadMessages.length;

  /*
   * ============================================================
   * AFFICHAGE
   * ============================================================
   */

  return (
    <main className="section">
      <div className="container">

        {/* ======================================================
            HEADER
        ====================================================== */}

        <div className="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <div>
            <div className="text-sm font-bold text-blue-600">
              MON ESPACE
            </div>

            <h1 className="mt-2 text-4xl font-black">
              Bienvenue 👋
            </h1>

            <p className="mt-2 text-slate-500">
              Gérez votre compte et vos activités
              Folioga-Tech.
            </p>
          </div>

          <button
            type="button"
            onClick={handleLogout}
            className="btn btn-dark"
          >
            Se déconnecter
          </button>
        </div>

        {/* ======================================================
            PROFIL
        ====================================================== */}

        <section className="card mt-8 p-6">
          <div className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

            <div className="flex items-center gap-4">

              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl">
                {isTechnician
                  ? "🔧"
                  : "👤"}
              </div>

              <div>
                <h2 className="text-xl font-black text-slate-950">
                  {isTechnician
                    ? "Compte technicien"
                    : "Compte client"}
                </h2>

                <p className="mt-1 text-sm text-slate-500">
                  {profile.email}
                </p>
              </div>

            </div>

            <span className="w-fit rounded-full bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700">
              {isTechnician
                ? "Technicien"
                : "Client"}
            </span>

          </div>
        </section>

        {/* ======================================================
            STATISTIQUES
        ====================================================== */}

        <div className="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

          <div className="card p-5">
            <div className="flex items-center justify-between">
              <span className="text-2xl">
                🔧
              </span>

              <span className="text-3xl font-black">
                {repairs.length}
              </span>
            </div>

            <div className="mt-4 font-semibold text-slate-500">
              {isTechnician
                ? "Missions acceptées"
                : "Réparations"}
            </div>
          </div>

          <div className="card p-5">
            <div className="flex items-center justify-between">
              <span className="text-2xl">
                📦
              </span>

              <span className="text-3xl font-black">
                0
              </span>
            </div>

            <div className="mt-4 font-semibold text-slate-500">
              Commandes
            </div>
          </div>

          <div className="card p-5">
            <div className="flex items-center justify-between">
              <span className="text-2xl">
                ❤️
              </span>

              <span className="text-3xl font-black">
                0
              </span>
            </div>

            <div className="mt-4 font-semibold text-slate-500">
              Favoris
            </div>
          </div>

          {/* MESSAGERIE */}

          <a
            href="#messages"
            className={
              "card p-5 transition hover:-translate-y-0.5 hover:shadow-md " +
              (unreadCount > 0
                ? "border-blue-300 bg-blue-50/40"
                : "")
            }
          >
            <div className="flex items-center justify-between">

              <span className="text-2xl">
                💬
              </span>

              <span
                className={
                  "text-3xl font-black " +
                  (unreadCount > 0
                    ? "text-blue-600"
                    : "text-slate-950")
                }
              >
                {unreadCount}
              </span>

            </div>

            <div className="mt-4 flex items-center justify-between font-semibold">

              <span className="text-slate-500">
                Messages
              </span>

              {unreadCount > 0 && (
                <span className="rounded-full bg-blue-600 px-2.5 py-1 text-xs font-black text-white">
                  Non lu
                </span>
              )}

            </div>
          </a>

        </div>

        {/* ======================================================
            MESSAGERIE
        ====================================================== */}

        <section
          id="messages"
          className="card mt-8 scroll-mt-24 p-6"
        >

          <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

            <div>
              <div className="text-sm font-bold text-blue-600">
                💬 MESSAGERIE
              </div>

              <h2 className="mt-1 text-2xl font-black">
                Vos messages
              </h2>

              <p className="mt-2 text-sm text-slate-500">
                Retrouvez les conversations liées à vos
                réparations.
              </p>
            </div>

            {unreadCount > 0 && (
              <div className="w-fit rounded-full bg-blue-100 px-4 py-2 text-sm font-black text-blue-700">
                {unreadCount}{" "}
                {unreadCount === 1
                  ? "message non lu"
                  : "messages non lus"}
              </div>
            )}

          </div>

          {/* ERREUR MESSAGERIE */}

          {messagesError && (
            <div className="mt-6 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">

              <div className="font-black">
                ⚠️ Impossible de charger la messagerie
              </div>

              <div className="mt-2">
                {messagesError}
              </div>

            </div>
          )}

          {/* CHARGEMENT */}

          {messagesLoading && (
            <div className="mt-6 rounded-2xl bg-slate-50 p-6 text-center">
              <p className="font-semibold text-slate-500">
                Chargement de vos messages...
              </p>
            </div>
          )}

          {/* AUCUN MESSAGE */}

          {!messagesLoading &&
            !messagesError &&
            unreadCount === 0 && (
              <div className="mt-6 rounded-2xl bg-slate-50 p-8 text-center">

                <div className="text-4xl">
                  💬
                </div>

                <h3 className="mt-3 text-lg font-black text-slate-950">
                  Aucun message non lu
                </h3>

                <p className="mt-2 text-sm text-slate-500">
                  Vous êtes à jour. Les nouveaux messages
                  apparaîtront ici.
                </p>

              </div>
            )}

          {/* ====================================================
              LISTE DES MESSAGES NON LUS
          ==================================================== */}

          {!messagesLoading &&
            unreadCount > 0 && (
              <div className="mt-6 space-y-4">

                {unreadMessages.map((item) => {

                  const repair =
                    messageRepairs[
                      item.repair_request_id
                    ];

                  return (
                    <Link
                      key={item.id}
                      href={
                        `/${locale}/repairs/request/` +
                        item.repair_request_id
                      }
                      className="group block rounded-2xl border border-blue-200 bg-blue-50/50 p-5 transition hover:border-blue-400 hover:bg-blue-50 hover:shadow-md"
                    >

                      <div className="flex gap-4">

                        {/* ICÔNE */}

                        <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-2xl">
                          💬
                        </div>

                        {/* CONTENU */}

                        <div className="min-w-0 flex-1">

                          <div className="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">

                            <div>

                              <div className="text-xs font-black uppercase tracking-wide text-blue-600">
                                Nouveau message
                              </div>

                              <h3 className="mt-1 text-lg font-black text-slate-950">
                                {repair?.title ||
                                  "Conversation de réparation"}
                              </h3>

                              {repair?.device_type && (
                                <p className="mt-1 text-xs font-bold text-slate-500">
                                  🔧{" "}
                                  {repair.device_type}
                                </p>
                              )}

                            </div>

                            <span className="w-fit shrink-0 rounded-full bg-blue-600 px-3 py-1 text-xs font-black text-white">
                              NON LU
                            </span>

                          </div>

                          {/* MESSAGE */}

                          <div className="mt-4 rounded-xl bg-white p-4">

                            <p className="line-clamp-3 text-sm leading-6 text-slate-700">
                              {item.message}
                            </p>

                          </div>

                          {/* DATE + ACTION */}

                          <div className="mt-4 flex flex-col justify-between gap-2 text-xs sm:flex-row sm:items-center">

                            <span className="text-slate-400">
                              {new Date(
                                item.created_at
                              ).toLocaleString(
                                "fr-FR",
                                {
                                  day: "2-digit",
                                  month: "2-digit",
                                  year: "numeric",
                                  hour: "2-digit",
                                  minute: "2-digit",
                                }
                              )}
                            </span>

                            <span className="font-black text-blue-600 transition group-hover:translate-x-1">
                              Ouvrir la conversation →
                            </span>

                          </div>

                        </div>

                      </div>

                    </Link>
                  );
                })}

              </div>
            )}

        </section>

        {/* ======================================================
            RÉPARATIONS
        ====================================================== */}

        <section className="card mt-8 p-6">

          {isTechnician ? (
            <>
              {/* TECHNICIEN */}

              <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

                <div>
                  <div className="text-sm font-bold text-blue-600">
                    🔧 MES MISSIONS
                  </div>

                  <h2 className="mt-1 text-2xl font-black">
                    Réparations acceptées
                  </h2>

                  <p className="mt-2 text-sm text-slate-500">
                    Retrouvez les demandes pour lesquelles
                    le client vous a accepté.
                  </p>
                </div>

                <Link
                  href={`/${locale}/repairs/requests`}
                  className="btn btn-secondary"
                >
                  Voir les demandes
                </Link>

              </div>

            </>
          ) : (
            <>
              {/* CLIENT */}

              <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

                <div>
                  <div className="text-sm font-bold text-blue-600">
                    🔧 MES RÉPARATIONS
                  </div>

                  <h2 className="mt-1 text-2xl font-black">
                    Mes demandes de réparation
                  </h2>

                  <p className="mt-2 text-sm text-slate-500">
                    Retrouvez ici toutes vos demandes de
                    réparation et leur état.
                  </p>
                </div>

                <Link
                  href={`/${locale}/repairs`}
                  className="btn btn-primary"
                >
                  + Nouvelle demande
                </Link>

              </div>
            </>
          )}

          {/* ERREUR */}

          {repairsError && (
            <div className="mt-6 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">

              <div className="font-black">
                ⚠️ Erreur
              </div>

              <div className="mt-2">
                {repairsError}
              </div>

            </div>
          )}

          {/* CHARGEMENT */}

          {repairsLoading && (
            <div className="mt-6 rounded-2xl bg-slate-50 p-6 text-center">
              <p className="font-semibold text-slate-500">
                Chargement des réparations...
              </p>
            </div>
          )}

          {/* AUCUNE RÉPARATION */}

          {!repairsLoading &&
            !repairsError &&
            repairs.length === 0 && (
              <div className="mt-6 rounded-2xl bg-slate-50 p-8 text-center">

                <div className="text-4xl">
                  🔧
                </div>

                <h3 className="mt-3 text-lg font-black text-slate-950">
                  {isTechnician
                    ? "Aucune mission acceptée"
                    : "Aucune demande de réparation"}
                </h3>

                <p className="mt-2 text-sm text-slate-500">
                  {isTechnician
                    ? "Les missions acceptées par les clients apparaîtront ici."
                    : "Vos demandes de réparation apparaîtront ici."}
                </p>

              </div>
            )}

          {/* LISTE RÉPARATIONS */}

          {!repairsLoading &&
            repairs.length > 0 && (
              <div className="mt-6 grid gap-5 md:grid-cols-2">

                {repairs.map((repair) => (
                  <article
                    key={repair.id}
                    className="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-blue-300 hover:shadow-md"
                  >

                    <div className="flex items-start justify-between gap-4">

                      <div>

                        <div className="text-xs font-bold text-blue-600">
                          {repair.device_type ||
                            "Appareil"}
                        </div>

                        <h3 className="mt-1 text-xl font-black text-slate-950">
                          {repair.title}
                        </h3>

                      </div>

                      <span
                        className={
                          "shrink-0 rounded-full px-3 py-1 text-xs font-bold " +
                          getStatusClass(
                            repair.status
                          )
                        }
                      >
                        {getStatusLabel(
                          repair.status
                        )}
                      </span>

                    </div>

                    {repair.description && (
                      <p className="mt-4 line-clamp-2 text-sm text-slate-500">
                        {repair.description}
                      </p>
                    )}

                    <div className="mt-5 flex flex-wrap gap-4 text-xs text-slate-500">

                      {repair.budget !== null && (
                        <span>
                          💰 {repair.budget} €
                        </span>
                      )}

                      {(repair.city ||
                        repair.country) && (
                        <span>
                          📍{" "}
                          {[
                            repair.city,
                            repair.country,
                          ]
                            .filter(Boolean)
                            .join(", ")}
                        </span>
                      )}

                      <span>
                        📅{" "}
                        {new Date(
                          repair.created_at
                        ).toLocaleDateString(
                          "fr-FR"
                        )}
                      </span>

                    </div>

                    <Link
                      href={
                        `/${locale}/repairs/request/` +
                        repair.id
                      }
                      className="mt-5 flex w-full items-center justify-center rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-blue-600"
                    >
                      Voir la demande →
                    </Link>

                  </article>
                ))}

              </div>
            )}

        </section>

        {/* ======================================================
            ACTIVITÉ / ACTIONS RAPIDES
        ====================================================== */}

        <section className="mt-8">

          <h2 className="text-2xl font-black text-slate-950">
            Actions rapides
          </h2>

          <div className="mt-5 grid gap-4 sm:grid-cols-3">

            <Link
              href={`/${locale}/repairs`}
              className="card p-5 transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <div className="text-2xl">
                🔧
              </div>

              <div className="mt-3 font-black">
                Demander une réparation
              </div>

              <div className="mt-1 text-sm text-slate-500">
                Créer une nouvelle demande
              </div>
            </Link>

            <Link
              href={`/${locale}/technicians`}
              className="card p-5 transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <div className="text-2xl">
                👨‍🔧
              </div>

              <div className="mt-3 font-black">
                Trouver un technicien
              </div>

              <div className="mt-1 text-sm text-slate-500">
                Découvrir les techniciens
              </div>
            </Link>

            <Link
              href={`/${locale}/shop`}
              className="card p-5 transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <div className="text-2xl">
                🛒
              </div>

              <div className="mt-3 font-black">
                Explorer la boutique
              </div>

              <div className="mt-1 text-sm text-slate-500">
                Découvrir nos produits
              </div>
            </Link>

          </div>

        </section>

      </div>
    </main>
  );
}
