"use client";

import Link from "next/link";
import { use, useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "@/lib/supabase";

type UserProfile = {
  email: string;
  role: "client" | "technicien";
  stripe_connect_account_id: string | null;
  stripe_connect_onboarding_complete: boolean;
};

type Repair = {
  id: string;
  client_id: string;
  title: string;
  device_type: string;
  description: string;
  country: string;
  city: string | null;
  budget: number | null;
  status: string;
  created_at: string;
};

type UnreadMessage = {
  id: string;
  repair_request_id: string;
  sender_id: string;
  message: string;
  created_at: string;
  is_read: boolean;
};

type UnreadConversation = {
  repairRequestId: string;
  title: string;
  deviceType: string;
  unreadCount: number;
  lastMessage: string;
  lastMessageAt: string;
};

export default function DashboardPage({
  params,
}: {
  params: Promise<{ locale: string }>;
}) {
  const { locale } = use(params);
  const router = useRouter();

  const [profile, setProfile] = useState<UserProfile | null>(null);
  const [loading, setLoading] = useState(true);

  const [clientRepairs, setClientRepairs] = useState<Repair[]>([]);
  const [technicianRepairs, setTechnicianRepairs] = useState<Repair[]>([]);

  const [repairsLoading, setRepairsLoading] = useState(false);
  const [repairsError, setRepairsError] = useState<string | null>(null);

  const [unreadConversations, setUnreadConversations] = useState<
    UnreadConversation[]
  >([]);

  const [messagesLoading, setMessagesLoading] = useState(false);
  const [messagesError, setMessagesError] = useState<string | null>(null);

  const [stripeLoading, setStripeLoading] = useState(false);
  const [stripeError, setStripeError] = useState<string | null>(null);

  const isTechnician = profile?.role === "technicien";
  const repairs = isTechnician ? technicianRepairs : clientRepairs;

  const unreadTotal = unreadConversations.reduce(
    (total, conversation) => total + conversation.unreadCount,
    0
  );

  useEffect(() => {
    let mounted = true;

    async function loadUser() {
      setLoading(true);
      setRepairsError(null);
      setMessagesError(null);

      const {
        data: { user },
        error: userError,
      } = await supabase.auth.getUser();

      if (userError || !user) {
        router.replace(`/${locale}/login`);
        return;
      }

      const { data: profileData, error: profileError } = await supabase
        .from("profiles")
        .select(
          "role, stripe_connect_account_id, stripe_connect_onboarding_complete"
        )
        .eq("id", user.id)
        .maybeSingle();

      if (profileError) {
        console.error("Erreur profil :", profileError);
      }

      const metadataRole = user.user_metadata?.role;

      const role: "client" | "technicien" =
        profileData?.role === "technicien" ||
        profileData?.role === "technician" ||
        metadataRole === "technicien" ||
        metadataRole === "technician"
          ? "technicien"
          : "client";

      if (!mounted) return;

      setProfile({
        email: user.email || "",
        role,
        stripe_connect_account_id:
          profileData?.stripe_connect_account_id || null,
        stripe_connect_onboarding_complete:
          profileData?.stripe_connect_onboarding_complete === true,
      });

      await Promise.all([
        role === "technicien"
          ? loadTechnicianRepairs(user.id)
          : loadClientRepairs(user.id),
        loadUnreadMessages(user.id),
      ]);

      if (mounted) {
        setLoading(false);
      }
    }

    loadUser();

    return () => {
      mounted = false;
    };
  }, [locale, router]);

  async function loadClientRepairs(clientId: string) {
    setRepairsLoading(true);
    setRepairsError(null);

    const { data, error } = await supabase
      .from("repair_requests")
      .select(
        "id, client_id, title, device_type, description, country, city, budget, status, created_at"
      )
      .eq("client_id", clientId)
      .order("created_at", { ascending: false });

    if (error) {
      console.error("Erreur chargement réparations client :", error);
      setClientRepairs([]);
      setRepairsError(
        `Impossible de charger vos réparations : ${error.code || ""} ${
          error.message || ""
        }`
      );
      setRepairsLoading(false);
      return;
    }

    setClientRepairs((data || []) as Repair[]);
    setRepairsLoading(false);
  }

  async function loadTechnicianRepairs(technicianId: string) {
    setRepairsLoading(true);
    setRepairsError(null);

    const { data: interests, error: interestsError } = await supabase
      .from("repair_interests")
      .select("repair_request_id, technician_id, status")
      .eq("technician_id", technicianId)
      .eq("status", "accepted");

    if (interestsError) {
      console.error(
        "Erreur chargement missions technicien :",
        interestsError
      );
      setTechnicianRepairs([]);
      setRepairsError(
        `Impossible de charger vos missions : ${
          interestsError.code || ""
        } ${interestsError.message || ""}`
      );
      setRepairsLoading(false);
      return;
    }

    const requestIds = (interests || []).map(
      (interest) => interest.repair_request_id
    );

    if (requestIds.length === 0) {
      setTechnicianRepairs([]);
      setRepairsLoading(false);
      return;
    }

    const { data, error } = await supabase
      .from("repair_requests")
      .select(
        "id, client_id, title, device_type, description, country, city, budget, status, created_at"
      )
      .in("id", requestIds)
      .order("created_at", { ascending: false });

    if (error) {
      console.error("Erreur chargement demandes :", error);
      setTechnicianRepairs([]);
      setRepairsError(
        `Impossible de charger vos missions : ${error.code || ""} ${
          error.message || ""
        }`
      );
      setRepairsLoading(false);
      return;
    }

    setTechnicianRepairs((data || []) as Repair[]);
    setRepairsLoading(false);
  }

  async function loadUnreadMessages(userId: string) {
    setMessagesLoading(true);
    setMessagesError(null);

    const { data: messages, error } = await supabase
      .from("messages")
      .select(
        "id, repair_request_id, sender_id, message, created_at, is_read"
      )
      .eq("is_read", false)
      .neq("sender_id", userId)
      .order("created_at", { ascending: false });

    if (error) {
      console.error("Erreur messages :", error);
      setUnreadConversations([]);
      setMessagesError(
        `Impossible de charger les messages : ${error.code || ""} ${
          error.message || ""
        }`
      );
      setMessagesLoading(false);
      return;
    }

    const unreadMessages = (messages || []) as UnreadMessage[];

    if (unreadMessages.length === 0) {
      setUnreadConversations([]);
      setMessagesLoading(false);
      return;
    }

    const requestIds = Array.from(
      new Set(unreadMessages.map((message) => message.repair_request_id))
    );

    const { data: requests } = await supabase
      .from("repair_requests")
      .select("id, title, device_type")
      .in("id", requestIds);

    const requestMap = new Map(
      (requests || []).map((request) => [
        request.id,
        {
          title: request.title,
          deviceType: request.device_type,
        },
      ])
    );

    const grouped = new Map<string, UnreadConversation>();

    for (const message of unreadMessages) {
      const existing = grouped.get(message.repair_request_id);
      const request = requestMap.get(message.repair_request_id);

      if (existing) {
        existing.unreadCount += 1;
      } else {
        grouped.set(message.repair_request_id, {
          repairRequestId: message.repair_request_id,
          title: request?.title || "Réparation",
          deviceType: request?.deviceType || "",
          unreadCount: 1,
          lastMessage: message.message,
          lastMessageAt: message.created_at,
        });
      }
    }

    setUnreadConversations(Array.from(grouped.values()));
    setMessagesLoading(false);
  }

  async function handleStripeOnboarding() {
    if (!profile) return;

    setStripeLoading(true);
    setStripeError(null);

    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();

      if (!user) {
        router.replace(`/${locale}/login`);
        return;
      }

      const response = await fetch("/api/stripe/connect/onboard", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          technicianId: user.id,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.url) {
        throw new Error(
          data.error || "Impossible de démarrer Stripe Connect."
        );
      }

      window.location.href = data.url;
    } catch (error) {
      console.error("Stripe onboarding :", error);

      setStripeError(
        error instanceof Error
          ? error.message
          : "Impossible de démarrer Stripe Connect."
      );

      setStripeLoading(false);
    }
  }

  async function handleLogout() {
    await supabase.auth.signOut();
    router.replace(`/${locale}/login`);
  }

  if (loading) {
    return (
      <main className="mx-auto max-w-6xl px-6 py-16">
        <div className="card p-10 text-center">
          <p className="font-semibold text-slate-500">
            Chargement de votre espace...
          </p>
        </div>
      </main>
    );
  }

  if (!profile) {
    return null;
  }

  const stripeReady =
    isTechnician &&
    profile.stripe_connect_account_id &&
    profile.stripe_connect_onboarding_complete;

  return (
    <main className="mx-auto max-w-6xl px-6 py-10">
      {/* ====================================================
          HEADER
      ==================================================== */}

      <div className="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <div>
          <div className="text-sm font-bold text-blue-600">
            MON ESPACE
          </div>

          <h1 className="mt-2 text-4xl font-black">
            Bienvenue 👋
          </h1>

          <p className="mt-2 text-slate-500">
            Gérez votre compte et vos activités Folioga-Tech.
          </p>
        </div>

        <button
          type="button"
          onClick={handleLogout}
          className="btn btn-dark"
        >
          Se déconnecter
        </button>
      </div>

      {/* ====================================================
          PROFIL
      ==================================================== */}

      <section className="card mt-8 p-6">
        <div className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <div className="flex items-center gap-4">
            <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl">
              {isTechnician ? "🔧" : "👤"}
            </div>

            <div>
              <h2 className="text-xl font-black text-slate-950">
                {isTechnician
                  ? "Compte technicien"
                  : "Compte client"}
              </h2>

              <p className="mt-1 text-sm text-slate-500">
                {profile.email}
              </p>
            </div>
          </div>

          <span className="w-fit rounded-full bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700">
            {isTechnician ? "Technicien" : "Client"}
          </span>
        </div>
      </section>

      {/* ====================================================
          STRIPE CONNECT TECHNICIEN
      ==================================================== */}

      {isTechnician && (
        <section className="card mt-6 border-2 border-blue-100 p-6">
          <div className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div className="text-sm font-bold text-blue-600">
                💳 PORTEFEUILLE
              </div>

              <h2 className="mt-1 text-2xl font-black">
                Paiements technicien
              </h2>

              {stripeReady ? (
                <p className="mt-2 text-sm font-semibold text-green-600">
                  ✅ Votre compte Stripe est configuré.
                </p>
              ) : (
                <p className="mt-2 max-w-xl text-sm text-slate-500">
                  Configurez votre compte Stripe Connect pour pouvoir
                  recevoir les paiements de vos réparations.
                </p>
              )}
            </div>

            {!stripeReady && (
              <button
                type="button"
                onClick={handleStripeOnboarding}
                disabled={stripeLoading}
                className="btn btn-dark whitespace-nowrap"
              >
                {stripeLoading
                  ? "Ouverture de Stripe..."
                  : "Configurer mon portefeuille Stripe →"}
              </button>
            )}
          </div>

          {stripeError && (
            <div className="mt-5 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700">
              ⚠️ {stripeError}
            </div>
          )}
        </section>
      )}

      {/* ====================================================
          STATISTIQUES
      ==================================================== */}

      <div className="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div className="card p-5">
          <div className="flex items-center justify-between">
            <span className="text-2xl">🔧</span>

            <span className="text-3xl font-black">
              {repairs.length}
            </span>
          </div>

          <div className="mt-4 font-semibold text-slate-500">
            {isTechnician
              ? "Missions acceptées"
              : "Réparations"}
          </div>
        </div>

        <div className="card p-5">
          <div className="flex items-center justify-between">
            <span className="text-2xl">📦</span>

            <span className="text-3xl font-black">0</span>
          </div>

          <div className="mt-4 font-semibold text-slate-500">
            Commandes
          </div>
        </div>

        <div className="card p-5">
          <div className="flex items-center justify-between">
            <span className="text-2xl">❤️</span>

            <span className="text-3xl font-black">0</span>
          </div>

          <div className="mt-4 font-semibold text-slate-500">
            Favoris
          </div>
        </div>

        <a
          href="#messages"
          className={
            "card p-5 transition hover:-translate-y-1 hover:shadow-md " +
            (unreadTotal > 0
              ? "border-2 border-blue-300 bg-blue-50/50"
              : "")
          }
        >
          <div className="flex items-center justify-between">
            <span className="text-2xl">💬</span>

            <span className="text-3xl font-black">
              {unreadTotal}
            </span>
          </div>

          <div className="mt-4 font-semibold text-slate-500">
            Messages
          </div>
        </a>
      </div>

      {/* ====================================================
          MESSAGERIE
      ==================================================== */}

      <section id="messages" className="card mt-8 p-6">
        <div>
          <div className="text-sm font-bold text-blue-600">
            💬 MESSAGERIE
          </div>

          <h2 className="mt-1 text-2xl font-black">
            Vos messages
          </h2>

          <p className="mt-2 text-sm text-slate-500">
            Retrouvez les conversations liées à vos réparations.
          </p>
        </div>

        {messagesError && (
          <div className="mt-6 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">
            <div className="font-black">⚠️ Erreur</div>
            <div className="mt-2">{messagesError}</div>
          </div>
        )}

        {messagesLoading && (
          <div className="mt-6 rounded-2xl bg-slate-50 p-6 text-center">
            <p className="font-semibold text-slate-500">
              Chargement des messages...
            </p>
          </div>
        )}

        {!messagesLoading &&
          !messagesError &&
          unreadConversations.length === 0 && (
            <div className="mt-6 rounded-2xl bg-slate-50 p-8 text-center">
              <div className="text-3xl">💬</div>
              <h3 className="mt-3 font-black">
                Aucun nouveau message
              </h3>
              <p className="mt-2 text-sm text-slate-500">
                Vous n'avez aucun message non lu pour le moment.
              </p>
            </div>
          )}

        {!messagesLoading &&
          !messagesError &&
          unreadConversations.length > 0 && (
            <div className="mt-6 grid gap-4">
              {unreadConversations.map((conversation) => (
                <Link
                  key={conversation.repairRequestId}
                  href={`/${locale}/repairs/request/${conversation.repairRequestId}`}
                  className="rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300 hover:shadow-md"
                >
                  <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                    <div>
                      <div className="text-sm font-bold text-blue-600">
                        {conversation.deviceType}
                      </div>

                      <h3 className="mt-1 text-lg font-black">
                        {conversation.title}
                      </h3>

                      <p className="mt-2 text-sm text-slate-500">
                        {conversation.lastMessage}
                      </p>
                    </div>

                    <span className="w-fit rounded-full bg-blue-600 px-4 py-2 text-sm font-black text-white">
                      {conversation.unreadCount} nouveau
                      {conversation.unreadCount > 1 ? "x" : ""}
                    </span>
                  </div>
                </Link>
              ))}
            </div>
          )}
      </section>

      {/* ====================================================
          CONTENU RÉPARATIONS
      ==================================================== */}

      <section className="card mt-8 p-6">
        {isTechnician ? (
          <>
            <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
              <div>
                <div className="text-sm font-bold text-blue-600">
                  🔧 MES MISSIONS
                </div>

                <h2 className="mt-1 text-2xl font-black">
                  Réparations acceptées
                </h2>

                <p className="mt-2 text-sm text-slate-500">
                  Retrouvez les demandes pour lesquelles le client
                  vous a accepté.
                </p>
              </div>

              <Link
                href={`/${locale}/repairs/requests`}
                className="btn btn-secondary"
              >
                Voir les demandes
              </Link>
            </div>

            {repairsError && (
              <div className="mt-6 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">
                <div className="font-black">⚠️ Erreur</div>
                <div className="mt-2">{repairsError}</div>
              </div>
            )}

            {repairsLoading && (
              <div className="mt-6 rounded-2xl bg-slate-50 p-6 text-center">
                <p className="font-semibold text-slate-500">
                  Chargement des missions...
                </p>
              </div>
            )}

            {!repairsLoading &&
              !repairsError &&
              repairs.length === 0 && (
                <div className="mt-6 rounded-2xl bg-slate-50 p-8 text-center">
                  <div className="text-3xl">🔧</div>
                  <h3 className="mt-3 font-black">
                    Aucune mission acceptée
                  </h3>
                  <p className="mt-2 text-sm text-slate-500">
                    Vos missions apparaîtront ici.
                  </p>
                </div>
              )}

            {!repairsLoading &&
              !repairsError &&
              repairs.length > 0 && (
                <div className="mt-6 grid gap-4">
                  {repairs.map((repair) => (
                    <Link
                      key={repair.id}
                      href={`/${locale}/repairs/request/${repair.id}`}
                      className="rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300 hover:shadow-md"
                    >
                      <div className="text-sm font-bold text-blue-600">
                        {repair.device_type}
                      </div>

                      <h3 className="mt-1 text-lg font-black">
                        {repair.title}
                      </h3>

                      <p className="mt-2 text-sm text-slate-500">
                        {repair.description}
                      </p>

                      <div className="mt-4">
                        <span className="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                          {repair.status}
                        </span>
                      </div>
                    </Link>
                  ))}
                </div>
              )}
          </>
        ) : (
          <>
            <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
              <div>
                <div className="text-sm font-bold text-blue-600">
                  🔧 MES RÉPARATIONS
                </div>

                <h2 className="mt-1 text-2xl font-black">
                  Mes demandes
                </h2>

                <p className="mt-2 text-sm text-slate-500">
                  Retrouvez vos demandes de réparation.
                </p>
              </div>

              <Link
                href={`/${locale}/repairs/request`}
                className="btn btn-secondary"
              >
                Nouvelle réparation
              </Link>
            </div>

            {repairsError && (
              <div className="mt-6 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">
                <div className="font-black">⚠️ Erreur</div>
                <div className="mt-2">{repairsError}</div>
              </div>
            )}

            {repairsLoading && (
              <div className="mt-6 rounded-2xl bg-slate-50 p-6 text-center">
                <p className="font-semibold text-slate-500">
                  Chargement des réparations...
                </p>
              </div>
            )}

            {!repairsLoading &&
              !repairsError &&
              repairs.length === 0 && (
                <div className="mt-6 rounded-2xl bg-slate-50 p-8 text-center">
                  <div className="text-3xl">📱</div>
                  <h3 className="mt-3 font-black">
                    Aucune réparation
                  </h3>
                  <p className="mt-2 text-sm text-slate-500">
                    Créez votre première demande de réparation.
                  </p>
                </div>
              )}

            {!repairsLoading &&
              !repairsError &&
              repairs.length > 0 && (
                <div className="mt-6 grid gap-4">
                  {repairs.map((repair) => (
                    <Link
                      key={repair.id}
                      href={`/${locale}/repairs/request/${repair.id}`}
                      className="rounded-2xl border border-slate-200 p-5 transition hover:border-blue-300 hover:shadow-md"
                    >
                      <div className="text-sm font-bold text-blue-600">
                        {repair.device_type}
                      </div>

                      <h3 className="mt-1 text-lg font-black">
                        {repair.title}
                      </h3>

                      <p className="mt-2 text-sm text-slate-500">
                        {repair.description}
                      </p>

                      <div className="mt-4">
                        <span className="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                          {repair.status}
                        </span>
                      </div>
                    </Link>
                  ))}
                </div>
              )}
          </>
        )}
      </section>
    </main>
  );
}
