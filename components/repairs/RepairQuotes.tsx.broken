"use client";

import {
  ChangeEvent,
  useCallback,
  useEffect,
  useMemo,
  useState,
} from "react";

import { supabase } from "@/lib/supabase";

type QuoteStatus =
  | "draft"
  | "sent"
  | "viewed"
  | "negotiating"
  | "accepted"
  | "rejected"
  | "expired"
  | "cancelled"
  | "superseded";

type DiscountType = "none" | "percent" | "fixed";

type QuoteItem = {
  id?: string;
  description: string;
  item_type?: string;
  quantity: number;
  unit_price: number;
  total_price?: number;
  position?: number;
};

type Quote = {
  id: string;
  repair_request_id: string;
  technician_id: string;
  version: number;
  status: QuoteStatus;
  currency: string;
  subtotal: number;
  discount_type: DiscountType | null;
  discount_value: number;
  discount_amount: number;
  tax_rate: number;
  tax_amount: number;
  total_ht: number;
  total_ttc: number;
  notes: string | null;
  expires_at: string | null;
  accepted_at: string | null;
  rejected_at: string | null;
  created_at: string;
  updated_at: string;
  quote_number: string | null;
  promotion_code: string | null;
  locked_at: string | null;
  locked_by: string | null;
  parent_quote_id: string | null;
  last_saved_at: string | null;
  draft_data: Record<string, unknown> | null;
  commission_rate: number;
  commission_amount: number;
  technician_amount: number;
  paid_amount: number;
  refunded_amount: number;
  payment_status: string;
  paid_at: string | null;
  payment_reference: string | null;
  rejection_reason: string | null;
  items?: QuoteItem[];
};

type Props = {
  repairRequestId: string;
  clientId: string;
  technicianId: string | null;
  userId: string;
  userRole: string;
};

const STATUS_LABELS: Record<QuoteStatus, string> = {
  draft: "Brouillon",
  sent: "Envoyé",
  viewed: "Vu",
  negotiating: "Négociation",
  accepted: "Accepté",
  rejected: "Refusé",
  expired: "Expiré",
  cancelled: "Annulé",
  superseded: "Remplacé",
};

const CURRENCIES = ["EUR", "USD", "GBP", "CHF", "CAD"];

const VAT_RATES = [0, 5.5, 10, 20];

function newItem(): QuoteItem {
  return {
    id: crypto.randomUUID(),
    description: "",
    item_type: "other",
    quantity: 1,
    unit_price: 0,
    total_price: 0,
    position: 0,
  };
}

function addDays(days: number): string {
  const d = new Date();
  d.setDate(d.getDate() + days);
  return d.toISOString();
}

function money(value: number, currency: string): string {
  try {
    return new Intl.NumberFormat("fr-FR", {
      style: "currency",
      currency,
    }).format(Number(value) || 0);
  } catch {
    return `${Number(value || 0).toFixed(2)} ${currency}`;
  }
}

function escapeHtml(value: string): string {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

export default function RepairQuotes({
  repairRequestId,
  clientId,
  technicianId,
  userId,
  userRole,
}: Props) {
  const isClient = userId === clientId;

  const isTechnician =
    userRole === "technicien" ||
    userRole === "technician";

  const canEdit =
    isTechnician &&
    Boolean(technicianId) &&
    technicianId === userId;

  const [quotes, setQuotes] = useState<Quote[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [accepting, setAccepting] = useState(false);
  const [rejecting, setRejecting] = useState(false);
  const [paying, setPaying] = useState<string | null>(null);

  const [error, setError] = useState("");
  const [message, setMessage] = useState("");

  const [showEditor, setShowEditor] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);

  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");

  const [currency, setCurrency] = useState("EUR");
  const [taxRate, setTaxRate] = useState(20);

  const [discountType, setDiscountType] =
    useState<DiscountType>("none");

  const [discountValue, setDiscountValue] = useState(0);
  const [promotionCode, setPromotionCode] = useState("");

  const [notes, setNotes] = useState("");

  const [expiresAt, setExpiresAt] =
    useState(addDays(7).slice(0, 10));

  const [commissionRate, setCommissionRate] = useState(0);

  const [items, setItems] = useState<QuoteItem[]>([
    newItem(),
  ]);

  const [attachments, setAttachments] = useState<File[]>([]);
  const [photos, setPhotos] = useState<File[]>([]);

  const [chatMessage, setChatMessage] = useState("");
  const [paymentAmount, setPaymentAmount] = useState(0);
  const [refundAmount, setRefundAmount] = useState(0);

  const [savingDraft, setSavingDraft] = useState(false);
  const [lastSaved, setLastSaved] = useState<Date | null>(null);

  const draftKey =
    `folioga-repair-quote-draft-${repairRequestId}-${userId}`;

  const subtotal = useMemo(
    () =>
      items.reduce(
        (sum, item) =>
          sum +
          Math.max(0, Number(item.quantity) || 0) *
            Math.max(0, Number(item.unit_price) || 0),
        0
      ),
    [items]
  );

  const discountAmount = useMemo(() => {
    if (discountType === "percent") {
      return Math.min(
        subtotal,
        subtotal *
          Math.min(100, Math.max(0, discountValue)) /
          100
      );
    }

    if (discountType === "fixed") {
      return Math.min(
        subtotal,
        Math.max(0, discountValue)
      );
    }

    return 0;
  }, [subtotal, discountType, discountValue]);

  const totalHT = Math.max(
    0,
    subtotal - discountAmount
  );

  const taxAmount =
    totalHT * Math.max(0, taxRate) / 100;

  const totalTTC = totalHT + taxAmount;

  const commissionAmount =
    totalHT *
    Math.max(0, commissionRate) /
    100;

  const technicianAmount =
    Math.max(0, totalHT - commissionAmount);

  const loadQuotes = useCallback(async () => {
    setLoading(true);
    setError("");

    const { data, error: queryError } = await supabase
      .from("repair_quotes")
      .select("*")
      .eq("repair_request_id", repairRequestId)
      .order("version", { ascending: false });

    if (queryError) {
      console.error(queryError);
      setError("Impossible de charger les devis.");
      setLoading(false);
      return;
    }

    const quoteIds = (data || []).map(
      (quote) => quote.id
    );

    let itemsByQuote: Record<string, QuoteItem[]> = {};

    if (quoteIds.length) {
      const { data: itemRows } = await supabase
        .from("repair_quote_items")
        .select("*")
        .in("quote_id", quoteIds)
        .order("position", { ascending: true });

      for (const item of itemRows || []) {
        if (!itemsByQuote[item.quote_id]) {
          itemsByQuote[item.quote_id] = [];
        }

        itemsByQuote[item.quote_id].push({
          id: item.id,
          description: item.description,
          item_type: item.item_type,
          quantity: Number(item.quantity) || 0,
          unit_price: Number(item.unit_price) || 0,
          total_price: Number(item.total_price) || 0,
          position: Number(item.position) || 0,
        });
      }
    }

    const normalized: Quote[] = (data || []).map(
      (quote) => ({
        ...quote,
        version: Number(quote.version) || 1,
        subtotal: Number(quote.subtotal) || 0,
        discount_value:
          Number(quote.discount_value) || 0,
        discount_amount:
          Number(quote.discount_amount) || 0,
        tax_rate: Number(quote.tax_rate) || 0,
        tax_amount:
          Number(quote.tax_amount) || 0,
        total_ht:
          Number(quote.total_ht) || 0,
        total_ttc:
          Number(quote.total_ttc) || 0,
        commission_rate:
          Number(quote.commission_rate) || 0,
        commission_amount:
          Number(quote.commission_amount) || 0,
        technician_amount:
          Number(quote.technician_amount) || 0,
        paid_amount:
          Number(quote.paid_amount) || 0,
        refunded_amount:
          Number(quote.refunded_amount) || 0,
        items: itemsByQuote[quote.id] || [],
      })
    );

    setQuotes(normalized);
    setLoading(false);
  }, [repairRequestId]);

  useEffect(() => {
    loadQuotes();
  }, [loadQuotes]);

  useEffect(() => {
    if (!showEditor || !canEdit) {
      return;
    }

    const timer = window.setTimeout(async () => {
      setSavingDraft(true);

      const draft = {
        currency,
        taxRate,
        discountType,
        discountValue,
        promotionCode,
        notes,
        expiresAt,
        commissionRate,
        items,
      };

      const { error: draftError } = await supabase
        .from("repair_quotes")
        .update({
          draft_data: draft,
          last_saved_at: new Date().toISOString(),
        })
        .eq("id", editingId || "");

      if (!editingId || draftError) {
        try {
          localStorage.setItem(
            draftKey,
            JSON.stringify(draft)
          );
        } catch {}
      }

      setLastSaved(new Date());
      setSavingDraft(false);
    }, 800);

    return () => window.clearTimeout(timer);
  }, [
    showEditor,
    canEdit,
    editingId,
    currency,
    taxRate,
    discountType,
    discountValue,
    promotionCode,
    notes,
    expiresAt,
    commissionRate,
    items,
    draftKey,
  ]);

  function resetEditor() {
    setEditingId(null);
    setCurrency("EUR");
    setTaxRate(20);
    setDiscountType("none");
    setDiscountValue(0);
    setPromotionCode("");
    setNotes("");
    setExpiresAt(addDays(7).slice(0, 10));
    setCommissionRate(0);
    setItems([newItem()]);
    setAttachments([]);
    setPhotos([]);
    setLastSaved(null);
  }

  function restoreLocalDraft() {
    try {
      const raw = localStorage.getItem(draftKey);

      if (!raw) {
        return;
      }

      const draft = JSON.parse(raw);

      if (draft.currency) {
        setCurrency(draft.currency);
      }

      if (typeof draft.taxRate === "number") {
        setTaxRate(draft.taxRate);
      }

      if (draft.discountType) {
        setDiscountType(draft.discountType);
      }

      if (typeof draft.discountValue === "number") {
        setDiscountValue(draft.discountValue);
      }

      if (typeof draft.promotionCode === "string") {
        setPromotionCode(draft.promotionCode);
      }

      if (typeof draft.notes === "string") {
        setNotes(draft.notes);
      }

      if (typeof draft.expiresAt === "string") {
        setExpiresAt(draft.expiresAt);
      }

      if (typeof draft.commissionRate === "number") {
        setCommissionRate(draft.commissionRate);
      }

      if (
        Array.isArray(draft.items) &&
        draft.items.length
      ) {
        setItems(draft.items);
      }
    } catch (error) {
      console.error(error);
    }
  }

  function openNewQuote() {
    resetEditor();
    setShowEditor(true);

    window.setTimeout(() => {
      restoreLocalDraft();
    }, 0);
  }

  function updateItem(
    id: string | undefined,
    field: keyof QuoteItem,
    value: string | number
  ) {
    setItems((current) =>
      current.map((item) =>
        item.id === id
          ? {
              ...item,
              [field]: value,
            }
          : item
      )
    );
  }

  function removeItem(id: string | undefined) {
    setItems((current) => {
      const next = current.filter(
        (item) => item.id !== id
      );

      return next.length ? next : [newItem()];
    });
  }

  function duplicateQuote(quote: Quote) {
    setEditingId(null);
    setCurrency(quote.currency || "EUR");
    setTaxRate(Number(quote.tax_rate) || 0);
    setDiscountType(
      quote.discount_type || "none"
    );
    setDiscountValue(
      Number(quote.discount_value) || 0
    );
    setPromotionCode(
      quote.promotion_code || ""
    );
    setNotes(quote.notes || "");

    setExpiresAt(
      quote.expires_at
        ? new Date(quote.expires_at)
            .toISOString()
            .slice(0, 10)
        : addDays(7).slice(0, 10)
    );

    setCommissionRate(
      Number(quote.commission_rate) || 0
    );

    setItems(
      (quote.items || []).map((item) => ({
        ...item,
        id: crypto.randomUUID(),
      }))
    );

    setShowEditor(true);
    setMessage(
      `Devis ${
        quote.quote_number ||
        `V${quote.version}`
      } dupliqué.`
    );
  }

  function editQuote(quote: Quote) {
    if (
      quote.status === "accepted" ||
      quote.locked_at
    ) {
      setError(
        "Ce devis est verrouillé et ne peut plus être modifié."
      );
      return;
    }

    setEditingId(quote.id);
    setCurrency(quote.currency || "EUR");
    setTaxRate(Number(quote.tax_rate) || 0);

    setDiscountType(
      quote.discount_type || "none"
    );

    setDiscountValue(
      Number(quote.discount_value) || 0
    );

    setPromotionCode(
      quote.promotion_code || ""
    );

    setNotes(quote.notes || "");

    setExpiresAt(
      quote.expires_at
        ? new Date(quote.expires_at)
            .toISOString()
            .slice(0, 10)
        : addDays(7).slice(0, 10)
    );

    setCommissionRate(
      Number(quote.commission_rate) || 0
    );

    setItems(
      quote.items?.length
        ? quote.items.map((item) => ({
            ...item,
            id:
              item.id ||
              crypto.randomUUID(),
          }))
        : [newItem()]
    );

    setShowEditor(true);
  }

  async function saveQuote(
    status: "draft" | "sent"
  ) {
    if (!canEdit || !technicianId) {
      setError(
        "Seul le technicien responsable peut gérer ce devis."
      );
      return;
    }

    const cleanItems = items
      .filter(
        (item) =>
          item.description.trim().length > 0
      )
      .map((item, index) => ({
        description:
          item.description.trim(),
        item_type:
          item.item_type || "other",
        quantity: Math.max(
          0,
          Number(item.quantity) || 0
        ),
        unit_price: Math.max(
          0,
          Number(item.unit_price) || 0
        ),
        total_price:
          Math.max(
            0,
            Number(item.quantity) || 0
          ) *
          Math.max(
            0,
            Number(item.unit_price) || 0
          ),
        position: index,
      }));

    if (!cleanItems.length) {
      setError(
        "Ajoutez au moins une prestation."
      );
      return;
    }

    setSaving(true);
    setError("");
    setMessage("");

    const highestVersion = quotes.reduce(
      (max, quote) =>
        Math.max(
          max,
          Number(quote.version) || 0
        ),
      0
    );

    const current = editingId
      ? quotes.find(
          (quote) =>
            quote.id === editingId
        )
      : null;

    const version =
      current?.version ||
      highestVersion + 1;

    const quoteNumber =
      current?.quote_number ||
      `FT-${new Date().getFullYear()}-${String(
        highestVersion + 1
      ).padStart(5, "0")}`;

    const expiresISO = expiresAt
      ? new Date(
          `${expiresAt}T23:59:59`
        ).toISOString()
      : null;

    const payload = {
      repair_request_id:
        repairRequestId,
      technician_id: technicianId,
      version,
      status,
      currency,
      subtotal,
      discount_type:
        discountType === "none"
          ? null
          : discountType,
      discount_value: discountValue,
      discount_amount:
        discountAmount,
      tax_rate: taxRate,
      tax_amount: taxAmount,
      total_ht: totalHT,
      total_ttc: totalTTC,
      notes: notes.trim() || null,
      expires_at: expiresISO,
      quote_number: quoteNumber,
      promotion_code:
        promotionCode.trim() || null,
      commission_rate:
        commissionRate,
      commission_amount:
        commissionAmount,
      technician_amount:
        technicianAmount,
      last_saved_at:
        new Date().toISOString(),
      draft_data: {
        currency,
        taxRate,
        discountType,
        discountValue,
        promotionCode,
        notes,
        expiresAt,
        commissionRate,
        items: cleanItems,
      },
    };

    let quoteId = editingId;

    if (editingId) {
      const { error: updateError } =
        await supabase
          .from("repair_quotes")
          .update(payload)
          .eq("id", editingId);

      if (updateError) {
        setError(updateError.message);
        setSaving(false);
        return;
      }

      await supabase
        .from("repair_quote_items")
        .delete()
        .eq("quote_id", editingId);
    } else {
      const {
        data,
        error: insertError,
      } = await supabase
        .from("repair_quotes")
        .insert(payload)
        .select("id")
        .single();

      if (insertError || !data) {
        setError(
          insertError?.message ||
            "Impossible de créer le devis."
        );
        setSaving(false);
        return;
      }

      quoteId = data.id;
    }

    if (quoteId) {
      const rows = cleanItems.map(
        (item) => ({
          quote_id: quoteId,
          description:
            item.description,
          item_type: item.item_type,
          quantity: item.quantity,
          unit_price:
            item.unit_price,
          total_price:
            item.total_price,
          position: item.position,
        })
      );

      const { error: itemError } =
        await supabase
          .from("repair_quote_items")
          .insert(rows);

      if (itemError) {
        setError(
          `Devis créé mais erreur lignes : ${itemError.message}`
        );
        setSaving(false);
        return;
      }

      await supabase
        .from("repair_quote_versions")
        .insert({
          quote_id: quoteId,
          version,
          snapshot: {
            ...payload,
            items: cleanItems,
          },
          created_by: userId,
        });

      await supabase
        .from("repair_quote_events")
        .insert({
          quote_id: quoteId,
          actor_id: userId,
          event_type:
            status === "sent"
              ? "sent"
              : "created",
          new_status: status,
          amount: totalTTC,
          metadata: {
            version,
            quote_number:
              quoteNumber,
          },
        });

      if (status === "sent") {
        await supabase
          .from(
            "repair_quote_notifications"
          )
          .insert({
            quote_id: quoteId,
            recipient_id: clientId,
            type: "quote_sent",
            title: "Nouveau devis",
            message: `Le devis ${quoteNumber} est disponible.`,
          });
      }

      await uploadFiles(
        quoteId,
        attachments,
        "attachment"
      );

      await uploadFiles(
        quoteId,
        photos,
        "photo"
      );
    }

    try {
      localStorage.removeItem(
        draftKey
      );
    } catch {}

    setSaving(false);
    setShowEditor(false);
    setEditingId(null);

    setMessage(
      status === "sent"
        ? "Devis envoyé au client. ✅"
        : "Brouillon enregistré. 💾"
    );

    await loadQuotes();
  }

  async function uploadFiles(
    quoteId: string,
    files: File[],
    type: "attachment" | "photo"
  ) {
    if (!files.length) {
      return;
    }

    for (const file of files) {
      if (
        file.size >
        10 * 1024 * 1024
      ) {
        continue;
      }

      const path =
        `quotes/${quoteId}/${crypto.randomUUID()}-${file.name}`;

      const {
        error: uploadError,
      } = await supabase.storage
        .from("repair-quote-files")
        .upload(path, file);

      if (uploadError) {
        console.error(uploadError);
        continue;
      }

      if (type === "attachment") {
        await supabase
          .from(
            "repair_quote_attachments"
          )
          .insert({
            quote_id: quoteId,
            file_name: file.name,
            file_path: path,
            file_type: file.type,
            file_size: file.size,
            attachment_type:
              file.type.startsWith(
                "image/"
              )
                ? "image"
                : "document",
            created_by: userId,
          });
      } else {
        await supabase
          .from("repair_quote_photos")
          .insert({
            quote_id: quoteId,
            file_name: file.name,
            file_path: path,
            created_by: userId,
            position: 0,
          });
      }
    }
  }

  function handleAttachments(
    event: ChangeEvent<HTMLInputElement>
  ) {
    setAttachments(
      Array.from(
        event.target.files || []
      ).filter(
        (file) =>
          file.size <=
          10 * 1024 * 1024
      )
    );
  }

  function handlePhotos(
    event: ChangeEvent<HTMLInputElement>
  ) {
    setPhotos(
      Array.from(
        event.target.files || []
      ).filter(
        (file) =>
          file.size <=
          10 * 1024 * 1024
      )
    );
  }

  async function acceptQuote(
    quote: Quote
  ) {
    if (!isClient) {
      setError(
        "Seul le client peut accepter ce devis."
      );
      return;
    }

    if (
      quote.status !== "sent" &&
      quote.status !== "viewed" &&
      quote.status !== "negotiating"
    ) {
      return;
    }

    if (
      quote.expires_at &&
      new Date(quote.expires_at) <
        new Date()
    ) {
      setError(
        "Ce devis est expiré."
      );
      return;
    }

    if (
      !window.confirm(
        `Accepter ${
          quote.quote_number ||
          `V${quote.version}`
        } pour ${money(
          quote.total_ttc,
          quote.currency
        )} ?`
      )
    ) {
      return;
    }

    setAccepting(true);
    setError("");

    const now =
      new Date().toISOString();

    const {
      error: updateError,
    } = await supabase
      .from("repair_quotes")
      .update({
        status: "accepted",
        accepted_at: now,
        locked_at: now,
        locked_by: userId,
      })
      .eq("id", quote.id);

    if (updateError) {
      setError(
        updateError.message
      );
      setAccepting(false);
      return;
    }

    await supabase
      .from("repair_quotes")
      .update({
        status: "superseded",
      })
      .eq(
        "repair_request_id",
        repairRequestId
      )
      .neq("id", quote.id)
      .in("status", [
        "draft",
        "sent",
        "viewed",
        "negotiating",
      ]);

    await supabase
      .from("repair_quote_events")
      .insert({
        quote_id: quote.id,
        actor_id: userId,
        event_type: "accepted",
        old_status: quote.status,
        new_status: "accepted",
        amount: quote.total_ttc,
      });

    await supabase
      .from(
        "repair_quote_notifications"
      )
      .insert({
        quote_id: quote.id,
        recipient_id:
          quote.technician_id,
        type: "quote_accepted",
        title: "Devis accepté",
        message: `Le devis ${
          quote.quote_number ||
          `V${quote.version}`
        } a été accepté.`,
      });

    setAccepting(false);

    setMessage(
      "Devis accepté et verrouillé. 🔒"
    );

    await loadQuotes();
  }

  async function rejectQuote(
    quote: Quote
  ) {
    if (!isClient) {
      return;
    }

    const reason =
      window.prompt(
        "Motif du refus (facultatif) :"
      ) || "";

    setRejecting(true);

    const {
      error: updateError,
    } = await supabase
      .from("repair_quotes")
      .update({
        status: "rejected",
        rejected_at:
          new Date().toISOString(),
        rejection_reason:
          reason || null,
      })
      .eq("id", quote.id);

    if (updateError) {
      setError(
        updateError.message
      );
      setRejecting(false);
      return;
    }

    await supabase
      .from("repair_quote_events")
      .insert({
        quote_id: quote.id,
        actor_id: userId,
        event_type: "rejected",
        old_status: quote.status,
        new_status: "rejected",
        metadata: {
          reason,
        },
      });

    setRejecting(false);
    setMessage("Devis refusé.");

    await loadQuotes();
  }

  async function sendMessage(
    quote: Quote
  ) {
    if (!chatMessage.trim()) {
      return;
    }

    const {
      error: messageError,
    } = await supabase
      .from("repair_quote_messages")
      .insert({
        quote_id: quote.id,
        sender_id: userId,
        message:
          chatMessage.trim(),
      });

    if (messageError) {
      setError(
        messageError.message
      );
      return;
    }

    setChatMessage("");

    await supabase
      .from(
        "repair_quote_notifications"
      )
      .insert({
        quote_id: quote.id,
        recipient_id:
          userId ===
          quote.technician_id
            ? clientId
            : quote.technician_id,
        type: "quote_message",
        title: "Nouveau message",
        message:
          "Vous avez reçu un nouveau message concernant le devis.",
      });

    setMessage("Message envoyé.");
  }

  /*
   * PAIEMENT CLIENT
   *
   * Cette fonction ne marque PAS le devis comme payé.
   * Elle prépare simplement le passage au paiement.
   *
   * Le branchement Stripe devra être ajouté ici.
   */
  async function registerPayment(
  async function startClientPayment(
    quote: Quote
  ) {
    if (!isClient) {
      setError(
        "Seul le client peut effectuer le paiement."
      );
      return;
    }

    if (quote.status !== "accepted") {
      setError(
        "Le devis doit être accepté avant le paiement."
      );
      return;
    }

    if (
      quote.payment_status === "paid" ||
      Number(quote.paid_amount || 0) >=
        Number(quote.total_ttc || 0)
    ) {
      setMessage(
        "Ce devis est déjà payé. ✅"
      );
      return;
    }

    setPaying(quote.id);
    setError("");
    setMessage("");

    try {
      const response = await fetch(
        "/api/stripe/create-checkout-session",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify({
            quoteId: quote.id,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.error ||
            "Impossible de préparer le paiement."
        );
      }

      if (!data.url) {
        throw new Error(
          "Stripe n'a pas retourné de page de paiement."
        );
      }

      window.location.href = data.url;
    } catch (error) {
      console.error(
        "Erreur paiement Stripe:",
        error
      );

      setError(
        error instanceof Error
          ? error.message
          : "Impossible de démarrer le paiement."
      );

      setPaying(null);
    }
  }

    quote: Quote
  ) {
    const amount = Math.max(
      0,
      Number(paymentAmount) || 0
    );

    if (!amount) {
      return;
    }

    const remaining =
      Math.max(
        0,
        Number(quote.total_ttc || 0) -
          Number(
            quote.paid_amount || 0
          )
      );

    if (amount > remaining) {
      setError(
        `Le paiement dépasse le montant restant de ${money(
          remaining,
          quote.currency
        )}.`
      );
      return;
    }

    const { error } =
      await supabase
        .from(
          "repair_quote_payments"
        )
        .insert({
          quote_id: quote.id,
          amount,
          currency: quote.currency,
          status: "paid",
          provider: "manual",
          paid_at:
            new Date().toISOString(),
        });

    if (error) {
      setError(error.message);
      return;
    }

    const newPaidAmount =
      Number(
        quote.paid_amount || 0
      ) + amount;

    await supabase
      .from("repair_quotes")
      .update({
        paid_amount:
          newPaidAmount,
        payment_status:
          newPaidAmount >=
          Number(quote.total_ttc)
            ? "paid"
            : "partial",
        paid_at:
          new Date().toISOString(),
      })
      .eq("id", quote.id);

    await supabase
      .from(
        "repair_quote_financial_events"
      )
      .insert({
        quote_id: quote.id,
        technician_id:
          quote.technician_id,
        event_type: "payment",
        amount,
        commission_amount:
          amount *
          Number(
            quote.commission_rate || 0
          ) /
          100,
        technician_amount:
          amount -
          amount *
            Number(
              quote.commission_rate || 0
            ) /
            100,
        currency:
          quote.currency,
        description:
          "Paiement enregistré",
      });

    setPaymentAmount(0);
    setMessage(
      "Paiement enregistré. ✅"
    );

    await loadQuotes();
  }

  async function registerRefund(
    quote: Quote
  ) {
    const amount = Math.max(
      0,
      Number(refundAmount) || 0
    );

    if (!amount) {
      return;
    }

    const available =
      Number(
        quote.paid_amount || 0
      ) -
      Number(
        quote.refunded_amount || 0
      );

    if (amount > available) {
      setError(
        "Le remboursement dépasse le montant disponible."
      );
      return;
    }

    const { error } =
      await supabase
        .from(
          "repair_quote_refunds"
        )
        .insert({
          quote_id: quote.id,
          amount,
          currency: quote.currency,
          status: "completed",
          reason:
            "Remboursement manuel",
          refunded_at:
            new Date().toISOString(),
        });

    if (error) {
      setError(error.message);
      return;
    }

    await supabase
      .from("repair_quotes")
      .update({
        refunded_amount:
          Number(
            quote.refunded_amount || 0
          ) + amount,
      })
      .eq("id", quote.id);

    await supabase
      .from(
        "repair_quote_financial_events"
      )
      .insert({
        quote_id: quote.id,
        technician_id:
          quote.technician_id,
        event_type: "refund",
        amount: -amount,
        commission_amount: 0,
        technician_amount:
          -amount,
        currency:
          quote.currency,
        description:
          "Remboursement enregistré",
      });

    setRefundAmount(0);
    setMessage(
      "Remboursement enregistré."
    );

    await loadQuotes();
  }

  function printQuote(
    quote: Quote
  ) {
    const rows = (
      quote.items || []
    )
      .map(
        (item) => `
          <tr>
            <td>${escapeHtml(
              item.description
            )}</td>
            <td>${item.quantity}</td>
            <td>${money(
              item.unit_price,
              quote.currency
            )}</td>
            <td>${money(
              Number(item.quantity) *
                Number(
                  item.unit_price
                ),
              quote.currency
            )}</td>
          </tr>
        `
      )
      .join("");

    const win = window.open(
      "",
      "_blank"
    );

    if (!win) {
      setError(
        "La fenêtre PDF/impression a été bloquée."
      );
      return;
    }

    win.document.write(`
      <!doctype html>
      <html lang="fr">
      <head>
        <meta charset="utf-8">
        <title>${escapeHtml(
          quote.quote_number ||
            `Devis V${quote.version}`
        )}</title>
        <style>
          body {
            font-family: Arial, sans-serif;
            padding: 40px;
            color: #111827;
          }
          h1 { margin-bottom: 4px; }
          table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 30px;
          }
          th, td {
            border-bottom: 1px solid #ddd;
            padding: 10px;
            text-align: left;
          }
          .total {
            margin-top: 30px;
            text-align: right;
            font-size: 24px;
            font-weight: bold;
          }
        </style>
      </head>
      <body>
        <h1>Folioga-Tech</h1>

        <p>
          ${escapeHtml(
            quote.quote_number ||
              `Devis V${quote.version}`
          )}
        </p>

        <table>
          <thead>
            <tr>
              <th>Prestation</th>
              <th>Qté</th>
              <th>Prix</th>
              <th>Total</th>
            </tr>
          </thead>

          <tbody>
            ${rows}
          </tbody>
        </table>

        <div class="total">
          Total HT :
          ${money(
            quote.total_ht,
            quote.currency
          )}
          <br>
          TVA :
          ${money(
            quote.tax_amount,
            quote.currency
          )}
          <br>
          Total TTC :
          ${money(
            quote.total_ttc,
            quote.currency
          )}
        </div>

        ${
          quote.notes
            ? `<p>${escapeHtml(
                quote.notes
              )}</p>`
            : ""
        }

        <script>
          window.onload = function() {
            window.print();
          };
        </script>
      </body>
      </html>
    `);

    win.document.close();
  }

  const filteredQuotes =
    useMemo(() => {
      const query =
        search
          .trim()
          .toLowerCase();

      return quotes.filter(
        (quote) => {
          const matchesStatus =
            statusFilter ===
              "all" ||
            quote.status ===
              statusFilter;

          if (!query) {
            return matchesStatus;
          }

          const text = [
            quote.quote_number,
            quote.status,
            STATUS_LABELS[
              quote.status
            ],
            quote.notes,
            quote.promotion_code,
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

          return (
            matchesStatus &&
            text.includes(query)
          );
        }
      );
    }, [
      quotes,
      search,
      statusFilter,
    ]);

  const statistics =
    useMemo(() => {
      const accepted =
        quotes.filter(
          (q) =>
            q.status ===
            "accepted"
        );

      const sent =
        quotes.filter(
          (q) =>
            q.status ===
              "sent" ||
            q.status ===
              "viewed" ||
            q.status ===
              "negotiating" ||
            q.status ===
              "accepted"
        );

      const revenue =
        accepted.reduce(
          (sum, q) =>
            sum +
            Number(
              q.total_ttc || 0
            ),
          0
        );

      const commissions =
        accepted.reduce(
          (sum, q) =>
            sum +
            Number(
              q.commission_amount ||
                0
            ),
          0
        );

      return {
        total: quotes.length,
        accepted:
          accepted.length,
        sent: sent.length,
        revenue,
        commissions,
      };
    }, [quotes]);

  if (loading) {
    return (
      <section className="mt-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <p className="font-semibold text-slate-500">
          Chargement des devis...
        </p>
      </section>
    );
  }

  return (
    <section className="mt-8 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6 md:p-8">

      <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <div className="text-sm font-bold uppercase tracking-wider text-blue-600">
            💰 Folioga-Tech
          </div>

          <h2 className="mt-1 text-2xl font-black text-slate-950 sm:text-3xl">
            Devis & finances
          </h2>

          <p className="mt-2 text-sm text-slate-500">
            Création, versionnage,
            acceptation, paiement et
            suivi financier.
          </p>
        </div>

        {canEdit && (
          <button
            type="button"
            onClick={
              openNewQuote
            }
            className="w-full rounded-xl bg-slate-950 px-5 py-3 font-bold text-white hover:bg-blue-600 sm:w-auto"
          >
            + Nouveau devis
          </button>
        )}
      </div>

      {error && (
        <div className="mt-5 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700">
          {error}
        </div>
      )}

      {message && (
        <div className="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-700">
          {message}
        </div>
      )}

      <div className="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div className="rounded-2xl bg-slate-50 p-4">
          <div className="text-xs font-bold uppercase text-slate-500">
            Devis
          </div>
          <div className="mt-1 text-2xl font-black">
            {statistics.total}
          </div>
        </div>

        <div className="rounded-2xl bg-slate-50 p-4">
          <div className="text-xs font-bold uppercase text-slate-500">
            Acceptés
          </div>
          <div className="mt-1 text-2xl font-black text-emerald-600">
            {statistics.accepted}
          </div>
        </div>

        <div className="rounded-2xl bg-slate-50 p-4">
          <div className="text-xs font-bold uppercase text-slate-500">
            CA TTC
          </div>

          <div className="mt-1 text-lg font-black">
            {money(
              statistics.revenue,
              "EUR"
            )}
          </div>
        </div>

        <div className="rounded-2xl bg-slate-50 p-4">
          <div className="text-xs font-bold uppercase text-slate-500">
            Commission
          </div>

          <div className="mt-1 text-lg font-black">
            {money(
              statistics.commissions,
              "EUR"
            )}
          </div>
        </div>
      </div>

      {showEditor &&
        canEdit && (
          <div className="mt-7 rounded-3xl border border-blue-200 bg-blue-50/40 p-4 sm:p-6">

            <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <div className="text-sm font-bold text-blue-600">
                  {editingId
                    ? "Modification"
                    : "Nouveau devis"}
                </div>

                <h3 className="text-xl font-black">
                  Calcul instantané
                </h3>
              </div>

              <div className="text-xs font-semibold text-slate-500">
                {savingDraft
                  ? "Sauvegarde..."
                  : lastSaved
                  ? `Sauvegardé à ${lastSaved.toLocaleTimeString(
                      "fr-FR",
                      {
                        hour: "2-digit",
                        minute:
                          "2-digit",
                      }
                    )}`
                  : "Sauvegarde automatique"}
              </div>
            </div>

            <div className="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

              <label>
                <span className="mb-1 block text-sm font-bold">
                  Devise
                </span>

                <select
                  value={currency}
                  onChange={(e) =>
                    setCurrency(
                      e.target.value
                    )
                  }
                  className="w-full rounded-xl border border-slate-300 bg-white px-3 py-3"
                >
                  {CURRENCIES.map(
                    (item) => (
                      <option
                        key={item}
                        value={item}
                      >
                        {item}
                      </option>
                    )
                  )}
                </select>
              </label>

              <label>
                <span className="mb-1 block text-sm font-bold">
                  TVA
                </span>

                <select
                  value={taxRate}
                  onChange={(e) =>
                    setTaxRate(
                      Number(
                        e.target.value
                      )
                    )
                  }
                  className="w-full rounded-xl border border-slate-300 bg-white px-3 py-3"
                >
                  {VAT_RATES.map(
                    (rate) => (
                      <option
                        key={rate}
                        value={rate}
                      >
                        {rate} %
                      </option>
                    )
                  )}
                </select>
              </label>

              <label>
                <span className="mb-1 block text-sm font-bold">
                  Expiration
                </span>

                <input
                  type="date"
                  value={expiresAt}
                  onChange={(e) =>
                    setExpiresAt(
                      e.target.value
                    )
                  }
                  className="w-full rounded-xl border border-slate-300 bg-white px-3 py-3"
                />
              </label>

              <label>
                <span className="mb-1 block text-sm font-bold">
                  Commission %
                </span>

                <input
                  type="number"
                  min="0"
                  max="100"
                  step="0.01"
                  value={
                    commissionRate
                  }
                  onChange={(e) =>
                    setCommissionRate(
                      Number(
                        e.target.value
                      )
                    )
                  }
                  className="w-full rounded-xl border border-slate-300 bg-white px-3 py-3"
                />
              </label>
            </div>

            <div className="mt-6">
              <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <h4 className="text-lg font-black">
                  Prestations
                </h4>

                <button
                  type="button"
