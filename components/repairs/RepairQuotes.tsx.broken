                placeholder="Conditions, diagnostic, garantie..."
              />
            </label>

            <div className="mt-5 grid gap-4 sm:grid-cols-2">

              <label className="block">
                <span className="mb-1 block text-sm font-bold">
                  📎 Pièces jointes
                </span>

                <input
                  type="file"
                  multiple
                  onChange={
                    handleAttachments
                  }
                  className="w-full rounded-xl border border-dashed border-slate-300 bg-white p-3"
                />

                {attachments.length >
                  0 && (
                  <p className="mt-2 text-xs text-slate-500">
                    {
                      attachments.length
                    }{" "}
                    fichier(s)
                  </p>
                )}
              </label>

              <label className="block">
                <span className="mb-1 block text-sm font-bold">
                  📸 Photos diagnostic
                </span>

                <input
                  type="file"
                  accept="image/*"
                  capture="environment"
                  multiple
                  onChange={
                    handlePhotos
                  }
                  className="w-full rounded-xl border border-dashed border-slate-300 bg-white p-3"
                />

                {photos.length >
                  0 && (
                  <p className="mt-2 text-xs text-slate-500">
                    {photos.length}{" "}
                    photo(s)
                  </p>
                )}
              </label>
            </div>

            <div className="mt-6 rounded-3xl bg-slate-950 p-5 text-white">

              <div className="grid grid-cols-2 gap-4 lg:grid-cols-5">

                <div>
                  <div className="text-xs text-slate-400">
                    Sous-total
                  </div>

                  <div className="font-black">
                    {money(
                      subtotal,
                      currency
                    )}
                  </div>
                </div>

                <div>
                  <div className="text-xs text-slate-400">
                    Remise
                  </div>

                  <div className="font-black">
                    -{" "}
                    {money(
                      discountAmount,
                      currency
                    )}
                  </div>
                </div>

                <div>
                  <div className="text-xs text-slate-400">
                    HT
                  </div>

                  <div className="font-black">
                    {money(
                      totalHT,
                      currency
                    )}
                  </div>
                </div>

                <div>
                  <div className="text-xs text-slate-400">
                    TVA
                  </div>

                  <div className="font-black">
                    {money(
                      taxAmount,
                      currency
                    )}
                  </div>
                </div>

                <div>
                  <div className="text-xs text-slate-400">
                    TTC
                  </div>

                  <div className="text-xl font-black">
                    {money(
                      totalTTC,
                      currency
                    )}
                  </div>
                </div>
              </div>

              <div className="mt-4 border-t border-slate-700 pt-4 text-sm">
                Commission Folioga-Tech :{" "}
                <strong>
                  {money(
                    commissionAmount,
                    currency
                  )}
                </strong>
                {" · "}
                Technicien :{" "}
                <strong>
                  {money(
                    technicianAmount,
                    currency
                  )}
                </strong>
              </div>
            </div>

            <div className="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">

              <button
                type="button"
                disabled={saving}
                onClick={() =>
                  saveQuote(
                    "draft"
                  )
                }
                className="rounded-xl border border-slate-300 bg-white px-5 py-3 font-bold"
              >
                💾 Brouillon
              </button>

              <button
                type="button"
                disabled={saving}
                onClick={() =>
                  saveQuote(
                    "sent"
                  )
                }
                className="rounded-xl bg-blue-600 px-5 py-3 font-bold text-white"
              >
                {saving
                  ? "Enregistrement..."
                  : "📤 Enregistrer et envoyer"}
              </button>

              <button
                type="button"
                onClick={() => {
                  setShowEditor(
                    false
                  );
                  setEditingId(
                    null
                  );
                }}
                className="rounded-xl border border-slate-300 px-5 py-3 font-bold"
              >
                Annuler
              </button>
            </div>
          </div>
        )}

      <div className="mt-7 grid gap-3 md:grid-cols-[1fr_220px]">

        <input
          value={search}
          onChange={(e) =>
            setSearch(
              e.target.value
            )
          }
          placeholder="🔎 Rechercher un devis..."
          className="rounded-xl border border-slate-300 px-4 py-3"
        />

        <select
          value={statusFilter}
          onChange={(e) =>
            setStatusFilter(
              e.target.value
            )
          }
          className="rounded-xl border border-slate-300 bg-white px-4 py-3"
        >
          <option value="all">
            Tous les statuts
          </option>

          {(
            Object.keys(
              STATUS_LABELS
            ) as QuoteStatus[]
          ).map((status) => (
            <option
              key={status}
              value={status}
            >
              {
                STATUS_LABELS[
                  status
                ]
              }
            </option>
          ))}
        </select>
      </div>

      <div className="mt-6 space-y-5">

        {filteredQuotes.length ===
        0 ? (
          <div className="rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center">
            <div className="text-4xl">
              💰
            </div>

            <h3 className="mt-3 text-xl font-black">
              Aucun devis
            </h3>

            {canEdit && (
              <button
                type="button"
                onClick={
                  openNewQuote
                }
                className="mt-5 rounded-xl bg-slate-950 px-5 py-3 font-bold text-white"
              >
                + Créer un devis
              </button>
            )}
          </div>
        ) : (
          filteredQuotes.map(
            (quote) => {
              const locked =
                quote.status ===
                  "accepted" ||
                Boolean(
                  quote.locked_at
                );

              const expired =
                Boolean(
                  quote.expires_at
                ) &&
                new Date(
                  quote.expires_at as string
                ) < new Date() &&
                !locked;

              const remaining =
                Math.max(
                  0,
                  Number(
                    quote.total_ttc ||
                      0
                  ) -
                    Number(
                      quote.paid_amount ||
                        0
                    )
                );

              const isPaid =
                quote.payment_status ===
                  "paid" ||
                remaining <= 0;

              return (
                <article
                  key={quote.id}
                  className={`rounded-3xl border bg-white p-4 shadow-sm sm:p-6 ${
                    locked
                      ? "border-emerald-200"
                      : "border-slate-200"
                  }`}
                >

                  <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

                    <div>
                      <div className="text-xs font-bold uppercase text-slate-500">
                        {quote.quote_number ||
                          `V${quote.version}`}
                      </div>

                      <div className="mt-2 flex flex-wrap gap-2">

                        <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold">
                          V
                          {
                            quote.version
                          }
                        </span>

                        <span
                          className={`rounded-full px-3 py-1 text-xs font-bold ${
                            locked
                              ? "bg-emerald-50 text-emerald-700"
                              : expired
                              ? "bg-red-50 text-red-700"
                              : "bg-blue-50 text-blue-700"
                          }`}
                        >
                          {locked
                            ? "🔒 Accepté / verrouillé"
                            : expired
                            ? "⏰ Expiré"
                            : STATUS_LABELS[
                                quote.status
                              ]}
                        </span>

                      </div>
                    </div>

                    <div className="sm:text-right">
                      <div className="text-xs font-bold uppercase text-slate-500">
                        Total TTC
                      </div>

                      <div className="text-2xl font-black">
                        {money(
                          quote.total_ttc,
                          quote.currency
                        )}
                      </div>
                    </div>
                  </div>

                  <div className="mt-5 overflow-hidden rounded-2xl border border-slate-200">

                    {(quote.items ||
                      []).map(
                      (item) => (
                        <div
                          key={
                            item.id
                          }
                          className="grid gap-2 border-b border-slate-100 p-4 last:border-0 sm:grid-cols-[1fr_70px_130px_130px]"
                        >
                          <div className="font-semibold">
                            {
                              item.description
                            }
                          </div>

                          <div className="text-slate-500">
                            x
                            {
                              item.quantity
                            }
                          </div>

                          <div className="text-slate-500">
                            {money(
                              item.unit_price,
                              quote.currency
                            )}
                          </div>

                          <div className="font-bold">
                            {money(
                              Number(
                                item.quantity
                              ) *
                                Number(
                                  item.unit_price
                                ),
                              quote.currency
                            )}
                          </div>
                        </div>
                      )
                    )}

                  </div>

                  <div className="mt-5 grid gap-2 text-sm sm:ml-auto sm:max-w-sm">

                    <div className="flex justify-between">
                      <span className="text-slate-500">
                        HT
                      </span>

                      <strong>
                        {money(
                          quote.total_ht,
                          quote.currency
                        )}
                      </strong>
                    </div>

                    <div className="flex justify-between">
                      <span className="text-slate-500">
                        TVA{" "}
                        {
                          quote.tax_rate
                        }%
                      </span>

                      <strong>
                        {money(
                          quote.tax_amount,
                          quote.currency
                        )}
                      </strong>
                    </div>

                    <div className="flex justify-between border-t pt-3 text-lg">
                      <span className="font-black">
                        TTC
                      </span>

                      <strong>
                        {money(
                          quote.total_ttc,
                          quote.currency
                        )}
                      </strong>
                    </div>
                  </div>

                  {quote.notes && (
                    <div className="mt-5 rounded-2xl bg-slate-50 p-4 text-sm">
                      <strong>
                        Notes
                      </strong>

                      <p className="mt-1 whitespace-pre-wrap text-slate-600">
                        {
                          quote.notes
                        }
                      </p>
                    </div>
                  )}

                  <div className="mt-5 grid gap-2 text-sm sm:grid-cols-3">

                    <div className="rounded-xl bg-slate-50 p-3">
                      <span className="text-slate-500">
                        Payé
                      </span>

                      <div className="font-black">
                        {money(
                          quote.paid_amount,
                          quote.currency
                        )}
                      </div>
                    </div>

                    <div className="rounded-xl bg-slate-50 p-3">
                      <span className="text-slate-500">
                        Remboursé
                      </span>

                      <div className="font-black">
                        {money(
                          quote.refunded_amount,
                          quote.currency
                        )}
                      </div>
                    </div>

                    <div className="rounded-xl bg-slate-50 p-3">
                      <span className="text-slate-500">
                        Statut paiement
                      </span>

                      <div className="font-black">
                        {
                          quote.payment_status
                        }
                      </div>
                    </div>

                  </div>

                  {quote.expires_at && (
                    <div className="mt-4 text-sm text-slate-500">
                      ⏰ Expire le{" "}
                      {new Date(
                        quote.expires_at
                      ).toLocaleDateString(
                        "fr-FR"
                      )}
                    </div>
                  )}

                  {/* ACTIONS */}

                  <div className="mt-5 flex flex-col gap-2 sm:flex-row sm:flex-wrap">

                    {/* CLIENT : ACCEPTER */}

                    {isClient &&
                      !locked &&
                      !expired &&
                      [
                        "sent",
                        "viewed",
                        "negotiating",
                      ].includes(
                        quote.status
                      ) && (
                        <>
                          <button
                            type="button"
                            disabled={
                              accepting
                            }
                            onClick={() =>
                              acceptQuote(
                                quote
                              )
                            }
                            className="rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white hover:bg-emerald-700"
                          >
                            {accepting
                              ? "Acceptation..."
                              : "✅ Accepter"}
                          </button>

                          <button
                            type="button"
                            disabled={
                              rejecting
                            }
                            onClick={() =>
                              rejectQuote(
                                quote
                              )
                            }
                            className="rounded-xl border border-red-200 px-5 py-3 font-bold text-red-600"
                          >
                            ❌ Refuser
                          </button>
                        </>
                      )}

                    {/* CLIENT : PAIEMENT */}

                    {isClient &&
                      quote.status ===
                        "accepted" &&
                      !isPaid && (
                        <button
                          type="button"
                          disabled={
                            paying ===
                            quote.id
                          }
                          onClick={() =>
                            startClientPayment(
                              quote
                            )
                          }
                          className="rounded-xl bg-emerald-600 px-6 py-3 font-black text-white shadow-sm hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60"
                        >
                          {paying ===
                          quote.id
                            ? "Ouverture du paiement..."
                            : `💳 Payer ${money(
                                remaining,
                                quote.currency
                              )}`}
                        </button>
                      )}

                    {/* CLIENT : PAYÉ */}

                    {isClient &&
                      quote.status ===
                        "accepted" &&
                      isPaid && (
                        <div className="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-3 font-bold text-emerald-700">
                          ✅ Paiement complet
                        </div>
                      )}

                    {/* TECHNICIEN : MODIFIER */}

                    {canEdit &&
                      !locked && (
                        <button
                          type="button"
                          onClick={() =>
                            editQuote(
                              quote
                            )
                          }
                          className="rounded-xl border border-slate-300 px-5 py-3 font-bold"
                        >
                          ✏️ Modifier
                        </button>
                      )}

                    {/* TECHNICIEN : DUPLIQUER */}

                    {canEdit && (
                      <button
                        type="button"
                        onClick={() =>
                          duplicateQuote(
                            quote
                          )
                        }
                        className="rounded-xl border border-slate-300 px-5 py-3 font-bold"
                      >
                        📋 Dupliquer
                      </button>
                    )}

                    {/* PDF */}

                    <button
                      type="button"
                      onClick={() =>
                        printQuote(
                          quote
                        )
                      }
                      className="rounded-xl border border-slate-300 px-5 py-3 font-bold"
                    >
                      🧾 PDF
                    </button>

                  </div>

                  {/* DISCUSSION */}

                  <div className="mt-6 rounded-2xl border border-slate-200 p-4">

                    <div className="font-bold">
                      💬 Discussion
                    </div>

                    <div className="mt-3 flex gap-2">

                      <input
                        value={
                          chatMessage
                        }
                        onChange={(e) =>
                          setChatMessage(
                            e.target
                              .value
                          )
                        }
                        placeholder="Écrire un message..."
                        className="min-w-0 flex-1 rounded-xl border border-slate-300 px-3 py-3"
                      />

                      <button
                        type="button"
                        onClick={() =>
                          sendMessage(
                            quote
                          )
                        }
                        className="rounded-xl bg-slate-950 px-4 py-3 font-bold text-white"
                      >
                        Envoyer
                      </button>

                    </div>
                  </div>

                  {/* TECHNICIEN : PAIEMENT MANUEL */}

                  {canEdit &&
                    quote.status ===
                      "accepted" && (
                      <div className="mt-6 grid gap-3 rounded-2xl border border-blue-200 bg-blue-50 p-4 sm:grid-cols-2">

                        <div>
                          <div className="font-bold">
                            💳 Paiement manuel
                          </div>

                          <div className="mt-2 text-xs text-slate-600">
                            Réservé au technicien / administrateur.
                          </div>

                          <div className="mt-2 flex gap-2">

                            <input
                              type="number"
                              min="0"
                              max={
                                remaining
                              }
                              step="0.01"
                              value={
                                paymentAmount
                              }
                              onChange={(
                                e
                              ) =>
                                setPaymentAmount(
                                  Number(
                                    e.target
                                      .value
                                  )
                                )
                              }
                              className="min-w-0 flex-1 rounded-xl border border-slate-300 px-3 py-2"
                              placeholder="Montant"
                            />

                            <button
                              type="button"
                              onClick={() =>
                                registerPayment(
                                  quote
                                )
                              }
                              className="rounded-xl bg-emerald-600 px-4 py-2 font-bold text-white"
                            >
                              Ajouter
                            </button>

                          </div>
                        </div>

                        <div>

                          <div className="font-bold">
                            💸 Remboursement
                          </div>

                          <div className="mt-2 flex gap-2">

                            <input
                              type="number"
                              min="0"
                              value={
                                refundAmount
                              }
                              onChange={(
                                e
                              ) =>
                                setRefundAmount(
                                  Number(
                                    e.target
                                      .value
                                  )
                                )
                              }
                              className="min-w-0 flex-1 rounded-xl border border-slate-300 px-3 py-2"
                              placeholder="Montant"
                            />

                            <button
                              type="button"
                              onClick={() =>
                                registerRefund(
                                  quote
                                )
                              }
                              className="rounded-xl border border-red-300 px-4 py-2 font-bold text-red-600"
                            >
                              Rembourser
                            </button>

                          </div>
                        </div>

                      </div>
                    )}

                  {/* LOCK */}

                  {locked && (
                    <div className="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-4">

                      <div className="font-black text-emerald-700">
                        🔒 Devis accepté et verrouillé
                      </div>

                      <p className="mt-1 text-sm text-emerald-700">
                        Toute modification future
                        doit créer une nouvelle
                        version.
                      </p>

                      {quote.accepted_at && (
                        <p className="mt-2 text-xs text-emerald-600">
                          Accepté le{" "}
                          {new Date(
                            quote.accepted_at
                          ).toLocaleString(
                            "fr-FR"
                          )}
                        </p>
                      )}

                    </div>
                  )}

                </article>
              );
            }
          )
        )}

      </div>
    </section>
  );
}
