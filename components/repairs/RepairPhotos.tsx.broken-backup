async function handleUpload(
event: React.ChangeEvent<HTMLInputElement>
) {
const files = event.target.files;

```
if (!files || files.length === 0) {
  return;
}

if (!userId) {
  setError("Vous devez être connecté.");
  return;
}

setUploading(true);
setError("");

try {
  const selectedFiles = Array.from(files);

  /*
   * Limite de sécurité côté interface.
   */

  const validFiles = selectedFiles.filter((file) => {
    const validType =
      file.type.startsWith("image/");

    const validSize =
      file.size <= 10 * 1024 * 1024;

    return validType && validSize;
  });

  if (validFiles.length !== selectedFiles.length) {
    setError(
      "Certains fichiers ont été ignorés. Seules les images de 10 Mo maximum sont acceptées."
    );
  }

  for (const file of validFiles) {
    /*
     * Nom unique.
     */

    const extension =
      file.name.split(".").pop()?.toLowerCase() ||
      "jpg";

    const randomId =
      typeof crypto !== "undefined" &&
      "randomUUID" in crypto
        ? crypto.randomUUID()
        : `${Date.now()}-${Math.random()
            .toString(36)
            .slice(2)}`;

    const storagePath =
      `${repairRequestId}/${selectedType}/${userId}/${randomId}.${extension}`;

    /*
     * --------------------------------------------------------
     * STORAGE
     * --------------------------------------------------------
     */

    const { error: uploadError } =
      await supabase.storage
        .from("repair-photos")
        .upload(storagePath, file, {
          cacheControl: "3600",
          upsert: false,
          contentType: file.type,
        });

    if (uploadError) {
      console.error(
        "Erreur upload photo :",
        uploadError
      );

      throw new Error(
        uploadError.message ||
          "Impossible d'envoyer la photo."
      );
    }

    /*
     * --------------------------------------------------------
     * URL PUBLIQUE
     * --------------------------------------------------------
     *
     * Le bucket doit être public pour cette version.
     */

    const {
      data: publicUrlData,
    } = supabase.storage
      .from("repair-photos")
      .getPublicUrl(storagePath);

    const photoUrl =
      publicUrlData.publicUrl;

    /*
     * --------------------------------------------------------
     * BASE DE DONNÉES
     * --------------------------------------------------------
     */

    const { data: insertedPhoto, error: insertError } =
      await supabase
        .from("repair_photos")
        .insert({
          repair_request_id: repairRequestId,
          uploaded_by: userId,
          photo_url: photoUrl,
          storage_path: storagePath,
          photo_type: selectedType,
          caption: null,
        })
        .select(
          `
            id,
            repair_request_id,
            uploaded_by,
            photo_url,
            storage_path,
            photo_type,
            caption,
            created_at
          `
        )
        .single();

    if (insertError) {
      /*
       * Si la DB échoue, on essaie de supprimer
       * le fichier déjà envoyé dans Storage.
       */

      await supabase.storage
        .from("repair-photos")
        .remove([storagePath]);

      console.error(
        "Erreur insertion photo :",
        insertError
      );

      throw new Error(
        insertError.message ||
          "Impossible d'enregistrer la photo."
      );
    }

    if (insertedPhoto) {
      setPhotos((current) => [
        insertedPhoto as RepairPhoto,
        ...current,
      ]);
    }
  }
} catch (uploadError) {
  console.error(uploadError);

  setError(
    uploadError instanceof Error
      ? uploadError.message
      : "Une erreur est survenue pendant l'envoi."
  );
} finally {
  setUploading(false);

  /*
   * Permet de sélectionner à nouveau le même fichier.
   */

  event.target.value = "";
}
